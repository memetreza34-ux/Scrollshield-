{
  "name": "scrollshield",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && tsx scripts/generate-service-worker.ts",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "generate:icons": "tsx scripts/generate-pwa-icons.ts",
    "generate:sw": "tsx scripts/generate-service-worker.ts",
    "check:bundle": "tsx scripts/check-bundle-budget.ts",
    "check:a11y": "tsx scripts/check-accessibility-source.ts",
    "check:android": "tsx scripts/check-android-project.ts",
    "check:android-hardening": "tsx scripts/check-android-release-hardening.ts",
    "check:binary-inspection": "tsx scripts/check-binary-inspection-contract.ts",
    "check:android-signing": "tsx scripts/check-android-release-signing.ts",
    "check:checker-drift": "tsx scripts/check-checker-architecture.ts",
    "check:android-instrumentation": "tsx scripts/check-android-instrumentation.ts",
    "check:lock-sync": "node scripts/check-package-lock-sync.mjs",
    "check:supply-chain": "tsx scripts/check-supply-chain.ts",
    "check:native-drain-ack": "tsx scripts/check-native-drain-ack.ts",
    "check:native-retention": "tsx scripts/check-native-retention.ts",
    "check:usage-flush-worker": "tsx scripts/check-usage-flush-worker.ts",
    "check:prerequisite-stop-codes": "tsx scripts/check-prerequisite-stop-codes.ts",
    "check:process-loss": "tsx scripts/check-process-loss-recovery.ts",
    "check:protection-recovery": "tsx scripts/check-protection-recovery.ts",
    "check:device-matrix": "tsx scripts/check-android-device-matrix.ts",
    "check:lifecycle": "tsx scripts/check-protection-lifecycle-diagnostics.ts",
    "check:native-stop-atomicity": "tsx scripts/check-native-stop-atomicity.ts",
    "check:start-handshake": "tsx scripts/check-start-handshake.ts",
    "check:config-durability": "tsx scripts/check-protection-config-durability.ts",
    "check:runtime-config-state": "tsx scripts/check-runtime-config-state.ts",
    "check:diagnostic-normalization": "tsx scripts/check-diagnostic-normalization.ts",
    "check:overlay-accessibility": "tsx scripts/check-overlay-accessibility.ts",
    "check:usage-accounting": "tsx scripts/check-native-usage-accounting.ts",
    "check:protection-config": "tsx scripts/check-protection-config.ts",
    "check:release-surface": "tsx scripts/check-release-surface.ts",
    "check:commitment": "tsx scripts/check-commitment-lock.ts",
    "check:subscription-safety": "tsx scripts/check-subscription-safety.ts",
    "check:subscription-integrity": "tsx scripts/check-subscription-integrity.ts",
    "check:migration": "tsx scripts/check-storage-migration.ts && tsx scripts/check-migration-recovery-ui.ts",
    "check:release-approval": "tsx scripts/check-release-approval.ts",
    "check:transparency": "tsx scripts/check-protection-transparency.ts",
    "check:version": "tsx scripts/check-version-consistency.ts",
    "check:privacy": "tsx scripts/check-privacy-build.ts",
    "check:secrets": "tsx scripts/check-no-secrets.ts",
    "check:pwa": "tsx scripts/check-pwa-build.ts",
    "check:release": "tsx scripts/check-release-readiness.ts",
    "check:release:strict": "tsx scripts/check-release-readiness.ts --strict",
    "check:runtime": "tsx scripts/check-runtime.ts",
    "check:sdk": "tsx scripts/check-sdk-registry.ts",
    "check:store": "tsx scripts/check-store-assets.ts",
    "check:notices": "tsx scripts/check-third-party-notices.ts",
    "release:candidate-gate": "tsx scripts/check-release-candidate-readiness.ts",
    "release:gate": "tsx scripts/check-release-approval.ts --strict",
    "readiness": "tsx scripts/readiness-report.ts",
    "analyze": "vite build --mode analyze",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:configure": "tsx scripts/configure-android-local.ts",
    "android:doctor": "tsx scripts/check-android-tooling.ts",
    "android:build": "tsx scripts/run-gradle.ts assembleDebug",
    "android:candidate:release": "npm run release:candidate-gate && npm run check:android-signing && tsx scripts/run-gradle.ts assembleRelease && tsx scripts/record-release-candidate.ts apk",
    "android:candidate:bundle": "npm run release:candidate-gate && npm run check:android-signing && tsx scripts/run-gradle.ts bundleRelease && tsx scripts/record-release-candidate.ts bundle",
    "android:inspect:candidate:release": "tsx scripts/inspect-release-candidate.ts apk",
    "android:inspect:candidate:bundle": "tsx scripts/inspect-release-candidate.ts bundle",
    "android:release": "npm run release:gate && tsx scripts/check-release-candidate-artifact.ts apk",
    "android:bundle": "npm run release:gate && tsx scripts/check-release-candidate-artifact.ts bundle",
    "verify:android": "tsx scripts/run-gradle.ts testDebugUnitTest assembleDebug --no-daemon --stacktrace",
    "verify:full": "npm run verify && npm run verify:android",
    "verify:local-evidence": "node scripts/run-local-verification.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run check:lock-sync && npm run check:runtime && npm run lint && npm run format:check && npm run check:version && npm run check:android && npm run check:android-hardening && npm run check:binary-inspection && npm run check:checker-drift && npm run check:android-instrumentation && npm run check:supply-chain && npm run check:native-drain-ack && npm run check:native-retention && npm run check:usage-flush-worker && npm run check:prerequisite-stop-codes && npm run check:process-loss && npm run check:protection-recovery && npm run check:device-matrix && npm run check:lifecycle && npm run check:native-stop-atomicity && npm run check:start-handshake && npm run check:config-durability && npm run check:runtime-config-state && npm run check:diagnostic-normalization && npm run check:overlay-accessibility && npm run check:usage-accounting && npm run check:protection-config && npm run check:release-surface && npm run check:commitment && npm run check:subscription-safety && npm run check:subscription-integrity && npm run check:migration && npm run check:release-approval && npm run check:transparency && npm run check:sdk && npm run check:notices && npm run check:secrets && npm run check:store && npm run check:release && npm run test && npm run check:a11y && npm run build && npm run check:pwa && npm run check:privacy && npm run check:bundle"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.12.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}