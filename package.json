{
  "name": "scrollshield",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && tsx scripts/generate-service-worker.ts",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "generate:icons": "tsx scripts/generate-pwa-icons.ts",
    "generate:sw": "tsx scripts/generate-service-worker.ts",
    "check:bundle": "tsx scripts/check-bundle-budget.ts",
    "check:a11y": "tsx scripts/check-accessibility-source.ts",
    "check:android": "tsx scripts/check-android-project.ts",
    "check:version": "tsx scripts/check-version-consistency.ts",
    "check:privacy": "tsx scripts/check-privacy-build.ts",
    "check:secrets": "tsx scripts/check-no-secrets.ts",
    "check:pwa": "tsx scripts/check-pwa-build.ts",
    "check:release": "tsx scripts/check-release-readiness.ts",
    "check:release:strict": "tsx scripts/check-release-readiness.ts --strict",
    "check:runtime": "tsx scripts/check-runtime.ts",
    "check:sdk": "tsx scripts/check-sdk-registry.ts",
    "check:store": "tsx scripts/check-store-assets.ts",
    "check:notices": "tsx scripts/check-third-party-notices.ts",
    "readiness": "tsx scripts/readiness-report.ts",
    "analyze": "vite build --mode analyze",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:configure": "tsx scripts/configure-android-local.ts",
    "android:doctor": "tsx scripts/check-android-tooling.ts",
    "android:build": "cd android && gradlew assembleDebug",
    "android:release": "cd android && gradlew assembleRelease",
    "android:bundle": "cd android && gradlew bundleRelease",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run check:runtime && npm run lint && npm run format:check && npm run check:version && npm run check:android && npm run check:sdk && npm run check:notices && npm run check:secrets && npm run check:store && npm run check:release && npm run test && npm run check:a11y && npm run build && npm run check:pwa && npm run check:privacy && npm run check:bundle"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.12.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
