{
  "entities": {
    "User": {
      "title": "User",
      "description": "User's application state and settings",
      "type": "object",
      "properties": {
        "hasCompletedOnboarding": { "type": "boolean" },
        "appsConfig": { "type": "object", "description": "Map of app configurations" },
        "isFocusModeActive": { "type": "boolean" },
        "focusTimeRemaining": { "type": "number" },
        "stats": { "type": "object" },
        "history": { "type": "array" },
        "profiles": { "type": "array" },
        "activeProfileId": { "type": "string" },
        "operatingSystem": { "type": "string" },
        "settings": { "type": "object" },
        "social": { "type": "object" },
        "uid": { "type": "string", "description": "The user's ID" }
      },
      "required": ["uid"]
    },
    "SocialConnection": {
      "title": "SocialConnection",
      "description": "A connection between two users for accountability or family mode",
      "type": "object",
      "properties": {
        "partnerId": { "type": "string" },
        "type": { "type": "string", "enum": ["accountability", "family", "partner", "friend"] },
        "status": { "type": "string", "enum": ["pending", "active", "blocked"] },
        "role": { "type": "string", "enum": ["peer", "guardian", "dependent"] },
        "permissions": { "type": "object" },
        "createdAt": { "type": "number" }
      },
      "required": ["partnerId", "type", "status", "role", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores the user's ScrollShield state"
    },
    "/users/{userId}/connections/{connectionId}": {
      "schema": { "$ref": "#/entities/SocialConnection" },
      "description": "Stores the user's social connections"
    }
  }
}
