<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- ScrollShield keeps protection state, usage history and recovery state local.
         Platform cloud backup and OEM/device-to-device migration are intentionally
         excluded; user-controlled JSON export/import is the supported transfer path. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
