<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Short-video surface detection is POST-V1 research.
             ShortVideoWatchService.kt remains in source for experiments, but
             the production V1 manifest deliberately does NOT register an
             AccessibilityService. Core protection must work without it. -->

        <!-- ── AppMonitorService ─────────────────────────────────────────────
             Foreground service that reads UsageStatsManager foreground events
             and shows a SYSTEM_ALERT_WINDOW interruption screen when a
             protected app is opened. Requires an approved Play Console
             declaration for FOREGROUND_SERVICE_SPECIAL_USE before upload;
             see docs/STORE_SUBMISSION_PACKET.md.
        -->
        <service
            android:name=".AppMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Self-control: shows a pause screen when the user opens an app they chose to limit" />
        </service>

        <!-- ── BootReceiver ──────────────────────────────────────────────────
             Restarts AppMonitorService after a reboot or an app update, if
             the user had monitoring on. Both actions are protected broadcasts
             that only the system can send; the receiver must be exported to
             receive them and ignores every other action.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- ── Permissions ──────────────────────────────────────────────────── -->

    <!-- Required: Detect which app is in the foreground (Usage Access) -->
    <!-- User must grant this manually in Settings → Usage Access -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Required: Show countdown overlay on top of blocked apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Required: Keep AppMonitorService alive as a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Needed for direct HTTPS purchase-token verification by native Android.
         No cleartext traffic permitted; the endpoint is BuildConfig-controlled. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Optional: Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Restart the app lock after a reboot or an update (BootReceiver). Also
         lets @capacitor/local-notifications restore scheduled reminders. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        @capacitor/local-notifications declares these as well; ScrollShield
        needs neither. Reminders are scheduled as inexact alarms
        (isExactNotification: false), which need no exact-alarm access and no
        Play Console declaration. The plugin never takes a wake lock.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <!-- ── Package visibility ───────────────────────────────────────────────
         Since Android 11 other apps are invisible unless listed here. These
         are the androidPackages of BUILTIN_PLATFORMS in src/types.tsx, so the
         app tiles can show the icon from the user's own launcher and the
         interruption screen the real app name. No QUERY_ALL_PACKAGES: a fixed
         list needs no Play Console declaration. npm run check:android keeps
         both lists in step.
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.instagram.lite" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.zhiliaoapp.musically.go" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.mango" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.twitter.android" />
        <package android:name="com.twitter.android.lite" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.reddit.frontpage.lite" />
        <package android:name="com.pinterest" />
        <!-- Home screens, so their time does not count as screen time (ForegroundUsage). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

</manifest>
